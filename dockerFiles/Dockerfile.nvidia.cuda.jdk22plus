## Docker File for TornadoVM on NVIDIA GPUs — CUDA (PTX) backend, Eclipse Temurin JDK 22+.
## Images: beehivelab/tornadovm-nvidia-cuda-jdk<JDK_VERSION>, published for JDK 25 (LTS) and
## JDK 27 (latest). Pick the JDK with --build-arg JDK_VERSION=<22+> (default 25), e.g.
## `./build.sh --nvidia-cuda-jdk27`.
##
## No source build: TornadoVM is installed from the release's prebuilt
## tornadovm-<ver>-jdk22plus-cuda-linux-amd64 SDK. The jdk22plus SDK (not the jdk21 one)
## is required here — its etc/tornado.jdk declares tornado.jdk.floor=22, and it vendors
## jdk.internal.vm.ci itself, so it runs unchanged on any JDK from 22 up.
##
## The SDK's native libraries (lib/libtornado-cudnn.so, lib/libtornado-cutlass.so) link
## against libcudart.so.13, libnvrtc.so.13 and libcudnn.so.9, hence the CUDA 13 + cuDNN 9
## runtime base image. The driver (libcuda, nvidia-smi) comes from the host via the NVIDIA
## container runtime (`docker run --runtime=nvidia` / `--gpus all`).

FROM nvidia/cuda:13.4.2-cudnn-runtime-ubuntu24.04

LABEL MAINTAINER Thanos Stratikopoulos <athanasios.stratikopoulos@manchester.ac.uk>

## TornadoVM release to install, as vX.Y.Z — override with --build-arg TORNADO_TAG=...
## (build.sh and the workflow pass this in explicitly).
ARG TORNADO_TAG=v7.2.0

## Eclipse Temurin feature release to install (22 or later) — override with
## --build-arg JDK_VERSION=... (build.sh and the workflow pass this in explicitly).
ARG JDK_VERSION=25

RUN apt-get update -q && apt-get install -qy --no-install-recommends \
        python3 wget unzip ca-certificates && rm -rf /var/lib/apt/lists/*

# Set UTF-8 locale env vars
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

## Eclipse Temurin JDK ${JDK_VERSION}, GA tarball from Adoptium (latest build of that release).
RUN wget -q -O /tmp/jdk.tar.gz \
        "https://api.adoptium.net/v3/binary/latest/${JDK_VERSION}/ga/linux/x64/jdk/hotspot/normal/eclipse" \
    && mkdir -p /opt/jdk \
    && tar xzf /tmp/jdk.tar.gz -C /opt/jdk --strip-components=1 \
    && rm /tmp/jdk.tar.gz
ENV JAVA_HOME=/opt/jdk

## TornadoVM SDK — the archive unpacks to tornadovm-<ver>-cuda/, moved to a fixed path.
## tornado-argfile is pre-expanded here: bin/tornado otherwise writes it into
## TORNADOVM_HOME on first run, which fails when the container runs as a non-root --user.
## Likewise var/ (CUDA code cache, OpenCL logs/cache) is created world-writable up front.
RUN TORNADO_VERSION="${TORNADO_TAG#v}" \
    && wget -q -O /tmp/tornadovm.zip \
        "https://github.com/beehive-lab/TornadoVM/releases/download/${TORNADO_TAG}/tornadovm-${TORNADO_VERSION}-jdk22plus-cuda-linux-amd64.zip" \
    && unzip -q /tmp/tornadovm.zip -d /opt \
    && mv "/opt/tornadovm-${TORNADO_VERSION}-cuda" /opt/tornadovm \
    && rm /tmp/tornadovm.zip \
    && sed 's|${TORNADOVM_HOME}|/opt/tornadovm|g' /opt/tornadovm/tornado-argfile.template \
        > /opt/tornadovm/tornado-argfile \
    && mkdir -p /opt/tornadovm/var && chmod 1777 /opt/tornadovm/var
ENV TORNADOVM_HOME=/opt/tornadovm
ENV PATH=$TORNADOVM_HOME/bin:$JAVA_HOME/bin:$PATH

WORKDIR /data
VOLUME ["/data"]
EXPOSE 3000
