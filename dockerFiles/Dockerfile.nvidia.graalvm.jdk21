## Docker File for TornadoVM on NVIDIA GPUs using GraalVM 23.1.0 JDK21
## OpenCL Backend only

FROM nvidia/opencl

LABEL MAINTAINER Juan Fumero <juan.fumero@manchester.ac.uk>

RUN apt-get update -q && apt-get install -qy \
        python3 build-essential vim git openjdk-17-jdk python3-pip \
        wget && rm -rf /var/lib/apt/lists/*

# Set UTF-8 locale env vars
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# (Optional but good) Install locales package if your base image needs it
RUN apt-get update && apt-get install -y locales && \
    locale-gen en_US.UTF-8 || true

# Upgrade pip tooling
RUN python3 -m pip install --upgrade pip setuptools wheel

RUN python3 -m pip install wget
RUN python3 -m pip install packaging
RUN python3 -m pip install streamlit

RUN ln -s /usr/bin/python3 /usr/bin/python

COPY settings/settings.xml /root/.m2/settings.xml

RUN java -version
RUN javac -version

ENV PATH /usr/lib/jvm/java-17-openjdk-amd64/bin:$PATH
ENV JAVA_HOME /usr/lib/jvm/java-17-openjdk-amd64

RUN java -version
RUN javac -version

## Install TornadoVM 
WORKDIR /tornado/
COPY settings/settings.xml /root/.m2/settings.xml
WORKDIR /tornado/
RUN git clone https://github.com/beehive-lab/TornadoVM.git tornado
WORKDIR /tornado/tornado
RUN git fetch --all --tags && git checkout tags/v5.2.0-jdk21
ENV CMAKE_ROOT /usr
RUN ./bin/tornadovm-installer --jdk graal-jdk-21 --backend opencl --auto-deps
RUN ln -s "$(find /tornado/tornado/etc/dependencies/TornadoVM-graal-jdk-21 -mindepth 1 -maxdepth 1 -type d)" \
    /tornado/tornado/etc/dependencies/TornadoVM-graal-jdk-21/current
SHELL ["/bin/bash", "-c", "source /tornado/tornado/setvars.sh"]

## JAVA_HOME resolved dynamically above via the "current" symlink — the
## installer always fetches the latest GraalVM JDK21 build, so a hardcoded
## version here (e.g. 21.0.1+12.1) breaks the moment a newer one ships.
ENV JAVA_HOME /tornado/tornado/etc/dependencies/TornadoVM-graal-jdk-21/current
ENV PATH /tornado/tornado/bin/bin:$PATH
ENV TORNADOVM_HOME /tornado/tornado/bin/sdk
ENV TORNADO_ROOT /tornado/tornado 

## Download NodeJS NPM packages
RUN $JAVA_HOME/bin/gu install nodejs
RUN $JAVA_HOME/bin/npm install express
RUN $JAVA_HOME/bin/npm install jimp

## Final Setup
WORKDIR /data
VOLUME ["/data"]
EXPOSE 3000 
